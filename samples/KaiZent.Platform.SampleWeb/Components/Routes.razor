<Router AppAssembly="typeof(App).Assembly" AdditionalAssemblies="new[] { typeof(KaiZentWebOptions).Assembly }">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData">
            <NotAuthorized><RedirectToLogin /></NotAuthorized>
        </AuthorizeRouteView>
    </Found>
</Router>
