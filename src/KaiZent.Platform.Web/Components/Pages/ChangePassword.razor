@page "/account/password"
@layout AccountLayout
@attribute [Authorize]
@inject Texts T
@inject IOptions<KaiZentWebOptions> Options

<PageTitle>@T["password.title"] · @Options.Value.ProductName</PageTitle>

<h1>@T["password.title"]</h1>
<p class="kz-subtitle">@(Required == "1" ? T["password.required"] : T["password.hint"])</p>

<form method="post" action="account/password/change" data-enhance="false">
    <AntiforgeryToken />
    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
    <div class="kz-field">
        <label for="currentPassword">@T["password.current"]</label>
        <input id="currentPassword" name="currentPassword" type="password" class="kz-input" autocomplete="current-password" required autofocus />
    </div>
    <div class="kz-field">
        <label for="newPassword">@T["password.new"]</label>
        <input id="newPassword" name="newPassword" type="password" class="kz-input" autocomplete="new-password" minlength="@Validation.MinPasswordLength" required />
    </div>
    <div class="kz-field">
        <label for="confirmPassword">@T["password.confirm"]</label>
        <input id="confirmPassword" name="confirmPassword" type="password" class="kz-input" autocomplete="new-password" required />
    </div>
    <p class="kz-small kz-muted">@T["password.rule"]</p>
    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="kz-error" role="alert">@ErrorText</div>
    }
    <button type="submit" class="kz-button-primary">@T["password.title"]</button>
</form>
@if (Required != "1")
{
    <p class="kz-small"><a href="account">@T["common.back"]</a></p>
}

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public string? Required { get; set; }

    private string ErrorText => Error switch
    {
        "current" => T["password.error.current"],
        "mismatch" => T["password.error.mismatch"],
        "weak" => T["password.error.weak"],
        "unreachable" => T["common.unreachable"],
        "form" => T["common.form_expired"],
        _ => T["password.error.weak"],
    };
}
