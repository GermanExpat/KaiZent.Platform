<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit- und Integrationstests. Integrationstests brauchen PostgreSQL: KAIZENT_TEST_POSTGRES setzen (Zugang mit CREATEDB),
       z. B. "Host=localhost;Username=postgres;Password=postgres". Ohne die Variable werden sie übersprungen. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(AspNetVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\samples\KaiZent.Platform.SampleHost\KaiZent.Platform.SampleHost.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
